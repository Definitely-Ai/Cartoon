{
  "name": "cartoon-site",
  "private": true,
  "type": "module",
  "description": "Static site for the cartoon company. The repo's filesystem is the CMS: /cartoons and /canon are read at build time.",
  "scripts": {
    "predev": "node scripts/validate-character-canon.mjs && node scripts/prebuild.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/validate-character-canon.mjs && node scripts/prebuild.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "brand-assets": "node scripts/generate-brand-assets.mjs",
    "dialogue": "node scripts/embed-dialogue.mjs",
    "canon:check": "node scripts/validate-character-canon.mjs",
    "training:detect": "node scripts/training/detect-figures.mjs",
    "training:variants": "node scripts/training/make-setting-variants.mjs",
    "training:build": "node scripts/training/build-training-set.mjs",
    "check:prompt": "node scripts/check-prompt-assembly.mjs",
    "training:refs": "node scripts/training/make-variant-refs.mjs"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
