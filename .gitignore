# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Assets copied into the site by the prebuild script.
# These are generated from /cartoons, /canon, and /options on every
# build, so they never need to be committed.
public/cartoons/
public/canon/
public/backroom-assets/

# Local env and editor noise
.env*
.DS_Store
*.log

# LoRA training artefacts. The manifest and the scripts are the source; the
# crops and the detector's previews are regenerated from them. NOT ignored:
# setting-variants/ and variant-refs/ (those images cost money to make or
# feed the paid generations) and training-set.zip (the exact bytes of a paid
# training run belong in history, and the training route reads the zip from
# the repo).
scripts/training/training-set/
scripts/training/training-set-v2/
scripts/training/.detect/
public/showcase/
public/vision/

.vercel/
.vercel

# Imported working artwork is deployed in a private snapshot package. This
# repository is public; do not accidentally publish the complete review archive.
public/studio-library/

# Room kit v2: regenerable bulk (draw-room-lines.py + room-part.py rebuild it); the approved parts, plate, prompts and manifest stay tracked
canon/room-kit/v2/history/
canon/room-kit/v2/work/
canon/room-kit/v2/stickers/
canon/room-kit/v2/tall/
canon/room-kit/v2/values/
canon/room-kit/v2/masks/
canon/room-kit/v2/shadows/
# The sticker desk's pulled decisions stay tracked (they are Rick's choices); only the machine's last-pull mark is local
canon/room-kit/v2/decisions/.last-pull.json
canon/plates/work/
tmp/
reports/*/SHOW-images/
